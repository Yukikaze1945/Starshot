<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OcrTinyTest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416;CS0108;CS8618;WMC1506;MVVMTK0049;MVVMTK0050</NoWarn>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="PublishedSmoke/**/*.cs" />
    <Compile Include="../../src/Starshot/Helpers/OcrModelStore.cs" Link="OcrModelStore.cs" />
    <Compile Include="../../src/Starshot/Helpers/OcrHelper.cs" Link="OcrHelper.cs" />
    <Compile Include="../../src/Starshot/Helpers/OcrTextFormatter.cs" Link="OcrTextFormatter.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/SrgbGammaEffect.cs" Link="SrgbGammaEffect.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="1.4.2" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Starward.Win2D" Version="1.3.2-release.1" />
  </ItemGroup>
  <Target Name="CopyStarwardWin2DRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)starward.win2d\1.3.2-release.1\lib\net6.0-windows10.0.19041.0\Microsoft.Graphics.Canvas.Interop.dll;$(NuGetPackageRoot)starward.win2d\1.3.2-release.1\runtimes\win-x64\native\Microsoft.Graphics.Canvas.dll"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>
</Project>
