<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>StaticVideoNativeTest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416;CS0108;CS8618;WMC1506;MVVMTK0049;MVVMTK0050</NoWarn>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Starshot/Features/Codec/StaticVideoSaver.cs" Link="StaticVideoSaver.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/StaticVideoEncoder.cs" Link="StaticVideoEncoder.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/StaticVideoMetadata.cs" Link="StaticVideoMetadata.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/HDR10GammaEffect.cs" Link="HDR10GammaEffect.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/ImageSaver.cs" Link="ImageSaver.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/SrgbGammaEffect.cs" Link="SrgbGammaEffect.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/UhdrColor.cs" Link="UhdrColor.cs" />
    <Compile Include="../../src/Starshot/Features/Codec/UhdrGainmapEffect.cs" Link="UhdrGainmapEffect.cs" />
    <Content Include="../../third_party/ffmpeg/7.1.1/win-x64/**/*"
             Link="VideoEncoder/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Starward.Codec" Version="0.5.2" />
    <PackageReference Include="Starward.Win2D" Version="1.3.2-release.1" />
  </ItemGroup>
</Project>
