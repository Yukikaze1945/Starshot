<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx
  x:Class="Starshot.Features.Screenshot.RegionCaptureWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mgcux="using:Microsoft.Graphics.Canvas.UI.Xaml"
  xmlns:sf="using:Starshot.Frameworks"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  mc:Ignorable="d"
>
  <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown" RequestedTheme="Light">
    <Grid.Resources>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E8ECD9" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DDF369" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#242B24" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#242B24" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
      <Style x:Key="RegionToolButton" TargetType="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="1,0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Foreground" Value="#242B24"/></Style>
    </Grid.Resources>
    <mgcux:CanvasSwapChainPanel
      x:Name="Canvas"
      PointerPressed="Canvas_PointerPressed"
      PointerMoved="Canvas_PointerMoved"
      PointerReleased="Canvas_PointerReleased"
    />
    <Canvas>
      <Border
        x:Name="SelectionMetrics"
        Background="#FAF9FAF3"
        BorderBrush="#D7DDCE"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,6"
        Visibility="Collapsed"
      >
        <TextBlock
          x:Name="SelectionMetricsText"
          Foreground="#242B24"
          FontFamily="Segoe UI Variable"
          FontSize="14"
          Text="0,0  0 × 0 px"
        />
      </Border>
      <Border x:Name="SelectionToolbar" Visibility="Collapsed" Background="#FFF9FAF3"
              BorderBrush="#D7DDCE" BorderThickness="1" CornerRadius="10">
        <Canvas x:Name="ToolbarButtons" />
      </Border>
      <Border x:Name="ToolbarParameters" Visibility="Collapsed" Background="#FFF9FAF3"
              BorderBrush="#D7DDCE" BorderThickness="1" CornerRadius="10">
        <Canvas x:Name="ToolbarParameterButtons" />
      </Border>
      <Border x:Name="ToolbarPopup" Visibility="Collapsed" Background="#FFF9FAF3"
              BorderBrush="#D7DDCE" BorderThickness="1" CornerRadius="10">
        <Canvas x:Name="ToolbarPopupButtons" />
      </Border>
      <Border x:Name="ShortcutHint" Visibility="Collapsed" Background="#FFF9FAF3"
              BorderBrush="#D7DDCE" BorderThickness="1" CornerRadius="10" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="ShortcutHintText" Foreground="#242B24" FontSize="12" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <Border x:Name="HdrAnalysisPanel" Visibility="Collapsed" Background="#FFF9FAF3"
              BorderBrush="#D7DDCE" BorderThickness="1" CornerRadius="12">
        <ScrollViewer x:Name="HdrAnalysisScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
      </Border>
      <TextBox x:Name="AnnotationTextEditor" Width="240" MinHeight="36" Visibility="Collapsed"
               Background="#FAF9FAF3" Foreground="#242B24" BorderBrush="#DDF369"
               PlaceholderText="输入文字，Enter 完成" AcceptsReturn="False"
               KeyDown="AnnotationTextEditor_KeyDown" LostFocus="AnnotationTextEditor_LostFocus" />
    </Canvas>
  </Grid>
</sf:WindowEx>
