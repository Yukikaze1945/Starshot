<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starshot.Features.ViewHost.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sf="using:Starshot.Frameworks"
 xmlns:mxi="using:Microsoft.Xaml.Interactivity" xmlns:sh="using:Starshot.Helpers">
 <Grid x:Name="RootGrid" Background="#181B19" RequestedTheme="Dark">
  <WebView2 x:Name="WebHost" Margin="0,32,0,0" />
  <Grid Height="32" VerticalAlignment="Top">
   <TextBlock Text="STARSHOT" Margin="20,0,0,0" VerticalAlignment="Center"
    FontSize="11" CharacterSpacing="200" Foreground="#BFC5BA" />
  </Grid>
  <StackPanel x:Name="NativeToastHost" Margin="24,64,24,24" MaxWidth="520" HorizontalAlignment="Right" VerticalAlignment="Bottom">
  </StackPanel>
  <StackPanel x:Name="LoadStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
   <TextBlock Text="STARSHOT" FontSize="28" CharacterSpacing="180" Foreground="#DDF369" />
   <TextBlock x:Name="LoadStatusText" Text="正在打开创作台…" Foreground="#BFC5BA" TextWrapping="Wrap" MaxWidth="480" />
   <Button x:Name="RetryButton" Content="重新加载界面" Visibility="Collapsed" Click="RetryButton_Click" />
  </StackPanel>
 </Grid>
</sf:WindowEx>
