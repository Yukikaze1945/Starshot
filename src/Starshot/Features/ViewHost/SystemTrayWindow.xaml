<sf:WindowEx
  x:Class="Starshot.Features.ViewHost.SystemTrayWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fluent="using:FluentIcons.WinUI"
  xmlns:hn="using:H.NotifyIcon"
  xmlns:lang="using:Starshot.Language"
  xmlns:local="using:Starshot.Features.ViewHost"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sf="using:Starshot.Frameworks"
  Title="StarwardTrayMenu"
  x:DefaultBindMode="OneWay"
  Closed="WindowEx_Closed"
  mc:Ignorable="d"
>
  <Grid Name="RootGrid">
    <hn:TaskbarIcon
      x:Name="trayIcon"
      LeftClickCommand="{x:Bind ShowMainWindowCommand}"
      NoLeftClickDelay="True"
      RightClickCommand="{x:Bind ShowCommand}"
      ToolTipText="Starshot"
    />

    <StackPanel Padding="8">
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind CaptureCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon FontSize="16" Glyph="&#xE722;" />
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind lang:Lang.Starshot_HotkeyScreenshot}"
          />
        </StackPanel>
      </Button>
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind CaptureRegionCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon FontSize="16" Glyph="&#xE8A9;" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Starshot_HotkeyRegion}" />
        </StackPanel>
      </Button>
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind CaptureRegionCopyCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon FontSize="16" Glyph="&#xE8C8;" />
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind lang:Lang.Starshot_HotkeyRegionCopy}"
          />
        </StackPanel>
      </Button>
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind CaptureRegionOcrCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <fluent:SymbolIcon FontSize="16" Symbol="ScanText" />
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind lang:Lang.ImageViewWindow_Ocr}"
          />
        </StackPanel>
      </Button>
      <MenuFlyoutSeparator />
      <TextBlock Margin="12,6,12,4" FontSize="12"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="截图模式" />
      <StackPanel x:Name="CaptureModeButtons" Margin="8,0" Spacing="2">
        <RadioButton x:Name="LightweightMode" GroupName="ScreenshotMode" Tag="0"
                     Content="轻量 · GDI / SDR" Click="CaptureMode_Click" />
        <RadioButton x:Name="StandardMode" GroupName="ScreenshotMode" Tag="1"
                     Content="标准 · WGC / SDR" Click="CaptureMode_Click" />
        <RadioButton x:Name="HdrMode" GroupName="ScreenshotMode" Tag="2"
                     Content="高质量 HDR" Click="CaptureMode_Click" />
        <RadioButton x:Name="HdrVideoMode" GroupName="ScreenshotMode" Tag="3"
                     Content="单帧 HDR 视频" Click="CaptureMode_Click" />
      </StackPanel>
      <Button Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Content="取消视频生成" Click="CancelVideo_Click" Style="{ThemeResource DateTimePickerFlyoutButtonStyle}" />
      <TextBlock x:Name="ModeStatus" Margin="12,4,12,4" MaxWidth="260"
                 FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      <MenuFlyoutSeparator />
      <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{x:Bind PinFromClipboardCommand}"
              Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon FontSize="16" Glyph="&#xE718;" />
          <TextBlock VerticalAlignment="Center" Text="从剪贴板贴图" />
        </StackPanel>
      </Button>
      <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{x:Bind ReopenPinCommand}"
              Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon FontSize="16" Glyph="&#xE72C;" />
          <TextBlock VerticalAlignment="Center" Text="恢复最近关闭的贴图" />
        </StackPanel>
      </Button>
      <MenuFlyoutSeparator />
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind ShowMainWindowCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon HorizontalAlignment="Center" FontSize="16" Glyph="&#xE80F;" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.MainPage_Launcher}" />
        </StackPanel>
      </Button>
      <Button
        Height="36"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Command="{x:Bind ExitCommand}"
        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon HorizontalAlignment="Center" FontSize="16" Glyph="&#xE7E8;" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Common_Exit}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</sf:WindowEx>
