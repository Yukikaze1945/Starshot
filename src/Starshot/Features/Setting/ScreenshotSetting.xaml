<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase
  x:Class="Starshot.Features.Setting.ScreenshotSetting"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sf="using:Starshot.Frameworks"
  x:DefaultBindMode="OneWay"
  mc:Ignorable="d"
>
  <ScrollViewer Padding="0">
    <StackPanel Width="820" Padding="36,24,36,36" Spacing="20">
      <TextBlock
        FontSize="28"
        FontWeight="Bold"
        Text="{x:Bind lang:Lang.Starshot_Nav_Screenshot}"
      />

      <!--  格式与质量  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_SDRFormat}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotSDRFormat, Mode=TwoWay}">
          <cwc:SegmentedItem Content="PNG" />
          <cwc:SegmentedItem Content="AVIF" />
          <cwc:SegmentedItem Content="JPEG XL" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_HDRFormat}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotHDRFormat, Mode=TwoWay}">
          <cwc:SegmentedItem Content="AVIF" />
          <cwc:SegmentedItem Content="JPEG XL" />
          <cwc:SegmentedItem Content="PNGv3" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_Quality}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotQuality, Mode=TwoWay}">
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_Medium}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_High}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.ScreenshotSetting_Lossless}" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="6">
        <ToggleSwitch
          IsOn="{x:Bind EnableScreenshotColorManagement, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}"
          OnContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_ColorManagementDesc}"
          TextWrapping="Wrap"
        />
      </StackPanel>

      <!--  HDR 处理  -->
      <StackPanel Spacing="12">
        <ToggleSwitch
          IsOn="{x:Bind AutoSaveUltraHDRJpeg, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}"
          OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_AutoConvertSDRDesc}"
          TextWrapping="Wrap"
        />
        <ToggleSwitch
          IsOn="{x:Bind DeleteHDRIfSDRContent, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDR}"
          OnContent="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDR}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDRDesc}"
          TextWrapping="Wrap"
        />
      </StackPanel>

      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
        Header="{x:Bind lang:Lang.UhdrCapacityTitle}">
        <StackPanel Spacing="12">
          <ToggleSwitch IsOn="{x:Bind UhdrCapacityManual, Mode=TwoWay}"
            OffContent="{x:Bind lang:Lang.UhdrCapacityAuto}"
            OnContent="{x:Bind lang:Lang.UhdrCapacityManual}" />
          <TextBlock Text="{x:Bind lang:Lang.UhdrCapacityDescription}" TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <NumberBox IsEnabled="{x:Bind UhdrCapacityManual}" Width="150" Minimum="2" Maximum="32" SmallChange="0.1" LargeChange="1"
                SpinButtonPlacementMode="Compact" Value="{x:Bind UhdrCapacityValue, Mode=TwoWay}"
                AutomationProperties.Name="HDR Capacity Max" />
              <TextBlock VerticalAlignment="Center" Text="{x:Bind UhdrCapacityLabel}" />
            </StackPanel>
            <Slider IsEnabled="{x:Bind UhdrCapacityManual}" Minimum="1" Maximum="5" StepFrequency="0.01" IsThumbToolTipEnabled="False"
              Value="{x:Bind UhdrCapacityStops, Mode=TwoWay}" AutomationProperties.Name="HDR Capacity Max" />
            <Grid><TextBlock Text="2×" /><TextBlock Text="32×" HorizontalAlignment="Right" /></Grid>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="4×" Tag="4" Click="UhdrCapacityPreset_Click" />
            <Button Content="8×" Tag="8" Click="UhdrCapacityPreset_Click" />
            <Button Content="12×" Tag="12" Click="UhdrCapacityPreset_Click" />
            <Button Content="16×" Tag="16" Click="UhdrCapacityPreset_Click" />
            <Button Content="Auto" Tag="Auto" Click="UhdrCapacityPreset_Click" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <!--  自动复制  -->
      <ToggleSwitch
        IsOn="{x:Bind AutoCopyScreenshotToClipboard, Mode=TwoWay}"
        OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}"
        OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}"
      />

      <!--  SDR 白基准  -->
      <StackPanel Spacing="6">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevel}" />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelDesc}"
          TextWrapping="Wrap"
        />
        <TextBlock
          x:Name="TextBlock_DisplaySdrWhite"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
        />
        <StackPanel Orientation="Horizontal">
          <ToggleSwitch
            IsOn="{x:Bind SdrWhiteLevelCustomize, Mode=TwoWay}"
            OffContent="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelCustomize}"
            OnContent="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelCustomize}"
          />
          <NumberBox
            Width="150"
            VerticalAlignment="Center"
            IsEnabled="{x:Bind SdrWhiteLevelCustomize}"
            Maximum="1000"
            Minimum="80"
            SmallChange="10"
            SpinButtonPlacementMode="Compact"
            Value="{x:Bind SdrWhiteLevelValue, Mode=TwoWay}"
          />
        </StackPanel>
      </StackPanel>

      <!--  捕获显示器  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_MonitorSource}" />
        <cwc:Segmented SelectedIndex="{x:Bind CaptureMonitorSource, Mode=TwoWay}">
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.Starshot_MonitorForeground}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.Starshot_MonitorCursor}" />
        </cwc:Segmented>
      </StackPanel>

      <!--  OCR 文字识别  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="文字识别引擎" />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="内置 PP-OCRv6 Tiny，使用 CPU 运行；Windows 上引擎不可用时自动回退到 Windows OCR。"
          TextWrapping="Wrap"
        />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Click="Button_TranslationConfig_Click" Content="OCR 翻译 API 设置" />
          <TextBlock VerticalAlignment="Center" FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="识别后先排版、编辑；翻译时才向配置的模型发送文字。" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</sf:PageBase>
