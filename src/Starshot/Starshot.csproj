<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Starshot</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416;CS0108;CS8600;CS8603;CS8618;CS9264;IL2026;IL2087;MVVMTK0049;MVVMTK0050;WMC1506</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../logo.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 自包含仅 Release（CI 发布产物）：Debug 框架依赖构建更快更省盘 -->
    <!-- <WindowsAppSDKSelfContained Condition="'$(Configuration)' != 'Debug'">true</WindowsAppSDKSelfContained>
		<SelfContained Condition="'$(Configuration)' != 'Debug'">true</SelfContained> -->
    <!-- 调试机 runtime 坏了，暂时先全部自包含，好了调回来 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>0.0.0-local</Version>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' == 'Debug'"
      >false</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' != 'Debug'"
      >true</CsWinRTAotOptimizerEnabled>
    <!-- CETCompat 继承，无验证记录，原因不明，保持不变 -->
    <CETCompat>false</CETCompat>
    <!-- 平铺输出：SDK 是在求值后的 OutputPath 后追加 TFM/RID 子目录（自定义路径也拼），删这两行原生资产会被分流进 win-x64/ -->
    <OutputPath>..\..\build\app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Release 发布配置（CLI dotnet publish -c Release 直接生效） -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>..\..\build\release\app\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--  DO NOT Update Segmented https://github.com/CommunityToolkit/Windows/pull/699  -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageReference
      Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock"
      Version="0.1.251030-build.2370"
    />
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <!-- FluentIcons 2.1.329：最后一个依赖 Win2D 1.3.2 的版本 -->
    <PackageReference Include="FluentIcons.WinUI" Version="2.1.329" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="1.4.2" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <PackageReference Include="Starward.Codec" Version="0.5.2" />
    <PackageReference Include="Starward.Win2D" Version="1.3.2-release.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.5" />
    <PackageReference Include="Vanara.PInvoke.Ole" Version="5.0.5" />
    <PackageReference Include="Vanara.PInvoke.Shell32" Version="5.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Font\PhotosIcons.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\third_party\simdpaddleocr\*"
             Link="ThirdParty\SimdPaddleOCR\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\logo.png" Link="Assets\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Starshot.Language\Starshot.Language.csproj" />
    <!-- Official Tiny models are embedded resources, not files in the NuGet cache.
         Keep the model and inference assemblies in trimmed Release publishes. -->
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.ModelProvider" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.TextLineOrientation" />
  </ItemGroup>

  <!-- The shipped WebUI is local and offline. No Vite server is required at runtime. -->
  <PropertyGroup>
    <WebUiRoot>$(MSBuildThisFileDirectory)..\Starshot.WebUI</WebUiRoot>
  </PropertyGroup>
  <ItemGroup>
    <WebUiSource Include="$(WebUiRoot)\src\**\*;$(WebUiRoot)\scripts\**\*;$(WebUiRoot)\index.html;$(WebUiRoot)\package.json;$(WebUiRoot)\package-lock.json;$(WebUiRoot)\vite.config.ts;$(WebUiRoot)\tsconfig.json" />
  </ItemGroup>
  <Target Name="RestoreStarshotWebUi"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(WebUiRoot)\package.json;$(WebUiRoot)\package-lock.json"
          Outputs="$(WebUiRoot)\node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebUiRoot)" />
  </Target>
  <Target Name="CompileStarshotWebUi" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreStarshotWebUi"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(WebUiSource)" Outputs="$(WebUiRoot)\dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(WebUiRoot)" />
  </Target>
  <Target Name="CopyStarshotWebUiForBuild" AfterTargets="Build" DependsOnTargets="CompileStarshotWebUi"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_WebUiBuildAsset Include="$(WebUiRoot)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUiBuildAsset)" DestinationFiles="@(_WebUiBuildAsset->'$(TargetDir)WebUI\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyStarshotWebUiForPublish" AfterTargets="Publish" DependsOnTargets="CompileStarshotWebUi">
    <ItemGroup>
      <_WebUiPublishAsset Include="$(WebUiRoot)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebUiPublishAsset)" DestinationFiles="@(_WebUiPublishAsset->'$(PublishDir)WebUI\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Starward.Codec supplies a stock native asset during build and publish. Replace it
       only after the SDK has completed its normal copy, then validate the final file. -->
  <PropertyGroup>
    <_UhdrCanonicalDll>$(MSBuildThisFileDirectory)..\..\third_party\libultrahdr\v2.0.2\win-x64\uhdr.dll</_UhdrCanonicalDll>
    <_UhdrVerifier>$(MSBuildThisFileDirectory)..\..\scripts\Verify-UhdrDll.ps1</_UhdrVerifier>
    <_UhdrExpectedSha256>415EE12ED6E979D1A96A495AFCB634D54FBACF69E5B9E45C95C38793C737384B</_UhdrExpectedSha256>
  </PropertyGroup>

  <Target Name="InstallVerifiedUhdrForBuild" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(_UhdrVerifier)&quot; -Path &quot;$(_UhdrCanonicalDll)&quot; -ExpectedSha256 $(_UhdrExpectedSha256)" />
    <Copy SourceFiles="$(_UhdrCanonicalDll)" DestinationFiles="$(TargetDir)uhdr.dll"
          SkipUnchangedFiles="false" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(_UhdrVerifier)&quot; -Path &quot;$(TargetDir)uhdr.dll&quot; -ExpectedSha256 $(_UhdrExpectedSha256)" />
  </Target>

  <Target Name="InstallVerifiedUhdrForPublish" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(_UhdrVerifier)&quot; -Path &quot;$(_UhdrCanonicalDll)&quot; -ExpectedSha256 $(_UhdrExpectedSha256)" />
    <Copy SourceFiles="$(_UhdrCanonicalDll)" DestinationFiles="$(PublishDir)uhdr.dll"
          SkipUnchangedFiles="false" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(_UhdrVerifier)&quot; -Path &quot;$(PublishDir)uhdr.dll&quot; -ExpectedSha256 $(_UhdrExpectedSha256)" />
  </Target>

  <!-- 若先编译了启动器会自动拷到 `build/release/` -->
  <Target Name="PrepareVideoEncoder" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Restore-VideoEncoder.ps1&quot;" />
  </Target>
  <Target Name="CopyVideoEncoderForBuild" AfterTargets="Build" DependsOnTargets="PrepareVideoEncoder"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup><_VideoBuild Include="$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\7.1.1\win-x64\*" /></ItemGroup>
    <Copy SourceFiles="@(_VideoBuild)" DestinationFolder="$(TargetDir)VideoEncoder" SkipUnchangedFiles="true" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Restore-VideoEncoder.ps1&quot; -VerifyOnly &quot;$(TargetDir)VideoEncoder&quot;" />
  </Target>
  <Target Name="CopyVideoEncoderForPublish" AfterTargets="Publish" DependsOnTargets="PrepareVideoEncoder"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup><_VideoPublish Include="$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\7.1.1\win-x64\*" /></ItemGroup>
    <Copy SourceFiles="@(_VideoPublish)" DestinationFolder="$(PublishDir)VideoEncoder" SkipUnchangedFiles="true" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Restore-VideoEncoder.ps1&quot; -VerifyOnly &quot;$(PublishDir)VideoEncoder&quot;" />
  </Target>

  <Target Name="CopyLauncher" AfterTargets="Publish">
    <PropertyGroup>
      <_ReleaseRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\build\release'))</_ReleaseRoot>
    </PropertyGroup>
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)..\..\build\Starshot.exe"
      DestinationFolder="$(_ReleaseRoot)"
      Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\Starshot.exe')"
    />
  </Target>
</Project>
